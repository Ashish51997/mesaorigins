{
  "name": "mesaorigins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "npm run clean && vite build && esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/server.mjs",
    "start": "node dist/server/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:server": "tsc -p server/tsconfig.json --noEmit",
    "test": "tsx src/test-all-features.ts",
    "test:unit": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:watch": "vitest",
    "docs:openapi": "tsx server/scripts/emitOpenApi.ts",
    "provision:aone": "tsx server/scripts/provisionAone.ts",
    "provision:platform-admin": "tsx server/scripts/provisionPlatformAdmin.ts",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:preflight:mesaerp": "tsx server/scripts/preflightMesaErpMigration.ts",
    "release:migrate": "npm run db:apply-runtime-role && npm run db:preflight:mesaerp && prisma migrate deploy && npm run db:apply-runtime-role && prisma migrate status",
    "db:apply-runtime-role": "prisma db execute --schema server/prisma/schema.prisma --file server/prisma/setup-roles.sql",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup:local": "npm run db:up && npx prisma generate && npm run release:migrate && npm run db:seed"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma",
    "seed": "tsx server/prisma/seed.ts"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@scalar/express-api-reference": "^0.7.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "d3": "^7.9.0",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  }
}
