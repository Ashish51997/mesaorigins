# Team local setup: copy to .env and follow docs/ops/local.md
#   cp .env.example .env
#   npm run db:up && npm run release:migrate && SEED_USER_PASSWORD=mesaorigins123 npm run db:seed
#   npm run dev
# Defaults below target Docker Postgres on localhost (not Neon). Each developer
# keeps their own DB so seeds and migrations do not collide across machines.

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# ---- Backend (Node + Postgres, multi-tenant) ----
# Runtime: the app connects as the least-privilege `app_user` so Postgres RLS
# enforces tenant isolation (superusers/BYPASSRLS roles ignore RLS). The role is
# created by server/prisma/setup-roles.sql (mounted by docker-compose on init).
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/masspolimer?schema=public"

# Migrations / seed / studio use the privileged owner role (creates tables,
# not blocked by RLS).
DIRECT_DATABASE_URL="postgresql://masspolimer:masspolimer@localhost:5432/masspolimer?schema=public"

# API server port.
PORT="3000"
# Temporary: also expose legacy flat MesaOps paths (/api/customers, …).
# Default on when NODE_ENV is not production. Set 0 to disable; prefer /api/mesaops/v1/*.
# MESAOPS_API_COMPAT="1"
# Number of known reverse-proxy hops. Keep 0 for direct/local traffic; set to
# the exact deployment topology so client-IP controls cannot trust forged XFF.
# Cloud Run uses 1 in the checked-in release pipeline.
TRUST_PROXY_HOPS="0"

# Optional release assertion. The runtime normally derives the newest expected
# migration from server/prisma/migrations; a deployment may additionally name a
# required migration here for an explicit rollout gate.
EXPECTED_MIGRATION=""

# Docker Compose host bindings and local Postgres owner settings. These are
# development defaults only; use managed secrets for any shared environment.
MESAORIGINS_APP_PORT="3000"
MESAORIGINS_POSTGRES_PORT="5432"
MESAORIGINS_POSTGRES_USER="masspolimer"
MESAORIGINS_POSTGRES_PASSWORD="masspolimer"
MESAORIGINS_POSTGRES_DB="masspolimer"
MESAORIGINS_SEED_PASSWORD="mesaorigins123"
# Header impersonation for the base Compose app. Keep disabled unless the stack
# is running on an isolated development machine; docker-compose.dev.yml enables
# it explicitly for hot reload.
MESAORIGINS_DEV_AUTH="0"

# Auth mode for a directly started Node process (outside Docker Compose):
#   DEV_AUTH=1  → local stub: x-dev-user header (employeeCode/email), login picker.
#   DEV_AUTH=0  → production: Auth.js session cookie (Google OAuth and/or email+password).
DEV_AUTH="1"

# Local/test-only escape hatch for pre-migration fixtures with no MesaOps
# RoleAssignment history. Leave empty by default; production ignores it even
# if accidentally set.
MESAOPS_ALLOW_LEGACY_UNASSIGNED=""

# Auth.js — required for Google OAuth, password login sessions, and DEV_AUTH=0.
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# MesaLeads quote-decision step-up verification. Online approval/revision is
# disabled unless a 32+ character code secret and a delivery method are set.
# The webhook receives JSON with recipient, template, code and lead reference.
MESALEADS_DECISION_CODE_SECRET=""
MESALEADS_DECISION_WEBHOOK_URL=""
MESALEADS_DECISION_WEBHOOK_BEARER=""
# Local/test only (ignored as a delivery method in NODE_ENV=production):
MESALEADS_DECISION_TEST_CODE=""

# MesaERP vendor bank accounts are encrypted before persistence. Supply exactly
# 32 random bytes encoded as base64 from a deployment secret store.
# Generate locally with: openssl rand -base64 32
MESAORIGINS_VENDOR_BANK_ENCRYPTION_KEY=""

# Internal MesaERP -> MesaOps snapshots require a service signature in addition
# to an authenticated employee session. Use different 32-byte base64 keys for
# handoffs, MesaERP-issued dispatch evidence and external compliance evidence.
# Generate each with: openssl rand -base64 32
MESAORIGINS_ERP_OPS_HANDOFF_HMAC_KEY=""
MESAORIGINS_OPS_STATUTORY_EVIDENCE_HMAC_KEY=""
MESAERP_EXTERNAL_EVIDENCE_HMAC_KEY=""

# Optional one-time password for `npm run provision:aone` (secret, minimum 10
# characters). It is applied only when the owner identity is newly created and
# never overwrites an existing global identity. For an already-provisioned
# owner, use a secure administrator password-set or verified invitation flow.
AONE_OWNER_PASSWORD=""
# Optional override for Auth.js base URL (defaults to APP_URL):
# AUTH_URL="http://localhost:3000"

# Google OAuth (optional). Redirect URI: {APP_URL}/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Internal-only onboarding route: comma-separated allowlist of signed-in admin emails.
# ONBOARDING_ALLOWED_EMAILS="aroul303@gmail.com"

# One-time platform administrator provisioner (`npm run provision:platform-admin`).
# Prefer a chmod-600 file so the password is not stored in shell history.
# PLATFORM_ADMIN_EMAIL="admin@example.com"
# PLATFORM_ADMIN_PASSWORD_FILE="/secure/path/platform-admin-password"
# PLATFORM_ADMIN_ORGANIZATION="demo" # existing organization id or slug
# PLATFORM_ADMIN_NAME="MesaOrigins Platform Administrator"
# PLATFORM_ADMIN_EMPLOYEE_CODE="PLATFORM-ADMIN"
# Existing identities fail closed. Set reuse after verifying the email owner;
# add rotate only when intentionally replacing that identity's password (this
# also revokes all of its existing sessions in the same transaction).
# PLATFORM_ADMIN_REUSE_EXISTING="0"
# PLATFORM_ADMIN_ROTATE_EXISTING="0"

# Seed: bcrypt hash applied to every demo User (npm run db:seed).
# SEED_USER_PASSWORD="mesaorigins123"

# Admin can set per-user passwords via POST /api/employees/:id/password

# ---- Cloud Run + Neon (production) ----
# Neon Singapore (aws-ap-southeast-1) + Cloud Run asia-southeast1.
# Runtime: pooled app_user URL. Migrations: unpooled owner URL only.
# DATABASE_URL="postgresql://app_user:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&connection_limit=5&pool_timeout=20&schema=public"
# DIRECT_DATABASE_URL="postgresql://neondb_owner:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&schema=public"
# On Cloud Run: DEV_AUTH=0, APP_URL/AUTH_URL=https://public-origin,
# TRUST_PROXY_HOPS=1, AUTH_SECRET and the four MesaERP/Ops cryptographic keys.
# Production outbox drains on-demand (no 2s timer) so Neon can scale to zero.
# Do not use Cloud SQL Unix-socket URLs (host=/cloudsql/...).
# Force a local continuous poller only when debugging handoffs:
# INTEGRATION_OUTBOX_CONTINUOUS_POLLING="1"
