# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# ---- Backend (Node + Postgres, multi-tenant) ----
# Runtime: the app connects as the least-privilege `app_user` so Postgres RLS
# enforces tenant isolation (superusers/BYPASSRLS roles ignore RLS). The role is
# created by server/prisma/setup-roles.sql (mounted by docker-compose on init).
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/masspolimer?schema=public"

# Migrations / seed / studio use the privileged owner role (creates tables,
# not blocked by RLS).
DIRECT_DATABASE_URL="postgresql://masspolimer:masspolimer@localhost:5432/masspolimer?schema=public"

# API server port.
PORT="3000"
# Number of known reverse-proxy hops. Keep 0 for direct/local traffic; set to
# the exact deployment topology so client-IP controls cannot trust forged XFF.
TRUST_PROXY_HOPS="0"

# Docker Compose host bindings and local Postgres owner settings. These are
# development defaults only; use managed secrets for any shared environment.
MESADESK_APP_PORT="3000"
MESADESK_POSTGRES_PORT="5432"
MESADESK_POSTGRES_USER="masspolimer"
MESADESK_POSTGRES_PASSWORD="masspolimer"
MESADESK_POSTGRES_DB="masspolimer"
MESADESK_SEED_PASSWORD="mesadesk123"
# Header impersonation for the base Compose app. Keep disabled unless the stack
# is running on an isolated development machine; docker-compose.dev.yml enables
# it explicitly for hot reload.
MESADESK_DEV_AUTH="0"

# Auth mode for a directly started Node process (outside Docker Compose):
#   DEV_AUTH=1  → local stub: x-dev-user header (employeeCode/email), login picker.
#   DEV_AUTH=0  → production: Auth.js session cookie (Google OAuth and/or email+password).
DEV_AUTH="1"

# Auth.js — required for Google OAuth, password login sessions, and DEV_AUTH=0.
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# MesaLeads quote-decision step-up verification. Online approval/revision is
# disabled unless a 32+ character code secret and a delivery method are set.
# The webhook receives JSON with recipient, template, code and lead reference.
MESALEADS_DECISION_CODE_SECRET=""
MESALEADS_DECISION_WEBHOOK_URL=""
MESALEADS_DECISION_WEBHOOK_BEARER=""
# Local/test only (ignored as a delivery method in NODE_ENV=production):
MESALEADS_DECISION_TEST_CODE=""

# Optional one-time password for `npm run provision:aone` (secret, minimum 10
# characters). It is applied only when the owner identity is newly created and
# never overwrites an existing global identity. For an already-provisioned
# owner, use a secure administrator password-set or verified invitation flow.
AONE_OWNER_PASSWORD=""
# Optional override for Auth.js base URL (defaults to APP_URL):
# AUTH_URL="http://localhost:3000"

# Google OAuth (optional). Redirect URI: {APP_URL}/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Internal-only onboarding route: comma-separated allowlist of signed-in admin emails.
# ONBOARDING_ALLOWED_EMAILS="aroul303@gmail.com"

# One-time platform administrator provisioner (`npm run provision:platform-admin`).
# Prefer a chmod-600 file so the password is not stored in shell history.
# PLATFORM_ADMIN_EMAIL="admin@example.com"
# PLATFORM_ADMIN_PASSWORD_FILE="/secure/path/platform-admin-password"
# PLATFORM_ADMIN_ORGANIZATION="demo" # existing organization id or slug
# PLATFORM_ADMIN_NAME="MesaDesk Platform Administrator"
# PLATFORM_ADMIN_EMPLOYEE_CODE="PLATFORM-ADMIN"
# Existing identities fail closed. Set reuse after verifying the email owner;
# add rotate only when intentionally replacing that identity's password (this
# also revokes all of its existing sessions in the same transaction).
# PLATFORM_ADMIN_REUSE_EXISTING="0"
# PLATFORM_ADMIN_ROTATE_EXISTING="0"

# Seed: bcrypt hash applied to every demo User (npm run db:seed).
# SEED_USER_PASSWORD="mesadesk123"

# Admin can set per-user passwords via POST /api/employees/:id/password

# ---- Cloud Run + Cloud SQL (Phase C) ----
# Use Unix socket URLs in Secret Manager (see DEPLOY_GCP.md):
# DATABASE_URL="postgresql://app_user:PASS@localhost/masspolimer?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"
# DIRECT_DATABASE_URL="postgresql://masspolimer:PASS@localhost/masspolimer?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"
# On Cloud Run: DEV_AUTH=0, AUTH_SECRET, and optional AUTH_GOOGLE_* from Secret Manager.
