# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Backend (Node + Postgres, multi-tenant) ----
# Runtime: the app connects as the least-privilege `app_user` so Postgres RLS
# enforces tenant isolation (superusers/BYPASSRLS roles ignore RLS). The role is
# created by server/prisma/setup-roles.sql (mounted by docker-compose on init).
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/masspolimer?schema=public"

# Migrations / seed / studio use the privileged owner role (creates tables,
# not blocked by RLS).
DIRECT_DATABASE_URL="postgresql://masspolimer:masspolimer@localhost:5432/masspolimer?schema=public"

# API server port.
PORT="3000"

# Phase-1 dev identity. While Firebase auth is deferred, DEV_AUTH=1 lets the API
# resolve the current user from the `x-dev-user` header (employeeCode/email),
# defaulting to a seeded Administrator. Set to 0 once real auth is wired.
DEV_AUTH="1"

# ---- Firebase Admin (Phase 2, not yet used) ----
# Path to a service-account JSON, or the JSON inline, for verifying ID tokens.
# FIREBASE_SERVICE_ACCOUNT=""
