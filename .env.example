# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# ---- Backend (Node + Postgres, multi-tenant) ----
# Runtime: the app connects as the least-privilege `app_user` so Postgres RLS
# enforces tenant isolation (superusers/BYPASSRLS roles ignore RLS). The role is
# created by server/prisma/setup-roles.sql (mounted by docker-compose on init).
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/masspolimer?schema=public"

# Migrations / seed / studio use the privileged owner role (creates tables,
# not blocked by RLS).
DIRECT_DATABASE_URL="postgresql://masspolimer:masspolimer@localhost:5432/masspolimer?schema=public"

# API server port.
PORT="3000"

# Auth mode:
#   DEV_AUTH=1  → local stub: x-dev-user header (employeeCode/email), login picker.
#   DEV_AUTH=0  → production: Auth.js session cookie (Google OAuth and/or email+password).
DEV_AUTH="1"

# Auth.js — required for Google OAuth, password login sessions, and DEV_AUTH=0.
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
# Optional override for Auth.js base URL (defaults to APP_URL):
# AUTH_URL="http://localhost:3000"

# Google OAuth (optional). Redirect URI: {APP_URL}/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Seed: bcrypt hash applied to every demo User (npm run db:seed).
# SEED_USER_PASSWORD="mesadesk123"

# Admin can set per-user passwords via POST /api/employees/:id/password

# ---- Cloud Run + Cloud SQL (Phase C) ----
# Use Unix socket URLs in Secret Manager (see DEPLOY_GCP.md):
# DATABASE_URL="postgresql://app_user:PASS@localhost/masspolimer?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"
# DIRECT_DATABASE_URL="postgresql://masspolimer:PASS@localhost/masspolimer?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"
# On Cloud Run: DEV_AUTH=0, AUTH_SECRET, and optional AUTH_GOOGLE_* from Secret Manager.
