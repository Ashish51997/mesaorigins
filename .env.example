# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Backend (Node + Postgres, multi-tenant) ----
# Runtime: the app connects as the least-privilege `app_user` so Postgres RLS
# enforces tenant isolation (superusers/BYPASSRLS roles ignore RLS). The role is
# created by server/prisma/setup-roles.sql (mounted by docker-compose on init).
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/masspolimer?schema=public"

# Migrations / seed / studio use the privileged owner role (creates tables,
# not blocked by RLS).
DIRECT_DATABASE_URL="postgresql://masspolimer:masspolimer@localhost:5432/masspolimer?schema=public"

# API server port.
PORT="3000"

# Auth mode:
#   DEV_AUTH=1  → Phase-1 stub: x-dev-user header (employeeCode/email), login picker.
#   DEV_AUTH=0  → production: require Authorization: Bearer <Firebase ID token>.
# A Bearer token is always verified when present, even if DEV_AUTH=1.
DEV_AUTH="1"

# Shared password for temporary email+password login (Cloud / LOGIN_PASSWORD set).
# Directory emails (e.g. deepak.bansal@masspolymer.in) + this password.
# When set, /api/health returns auth:"password" and Google sign-in is unused.
# LOGIN_PASSWORD="mesadesk123"
# Optional separate HMAC secret for session tokens (defaults to LOGIN_PASSWORD):
# SESSION_SECRET="change-me"

# ---- Firebase Admin (required when DEV_AUTH=0, or whenever clients send Bearer) ----
# Path to a service-account JSON file, OR the JSON inline as a single line.
# FIREBASE_SERVICE_ACCOUNT="/path/to/serviceAccount.json"
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'
# Optional override if the JSON omits project_id:
# FIREBASE_PROJECT_ID="your-gcp-project-id"
# Or use standard Google ADC:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/serviceAccount.json"

# ---- Cloud Run + Cloud SQL (Phase C) ----
# Use Unix socket URLs in Secret Manager (see DEPLOY_GCP.md):
# DATABASE_URL="postgresql://app_user:PASS@localhost/masspolimer?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"
# DIRECT_DATABASE_URL="postgresql://masspolimer:PASS@localhost/masspolimer?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"
# On Cloud Run: DEV_AUTH=0 and FIREBASE_SERVICE_ACCOUNT from Secret Manager.
