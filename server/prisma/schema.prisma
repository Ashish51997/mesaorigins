  geographyCoverage  Json     @default("[]")
  contacts           Json     @default("[]")
  paymentTerms       String   @default("")
  currency           String   @default("INR")
  creditDays         Int      @default(0)
  taxClassification  String   @default("")
  tdsClassification  String   @default("")
