// Mass Polimer ERP — multi-tenant data model.
//
// Tenancy: pooled shared schema. Every tenant-owned row carries `organizationId`
// (the tenant). Isolation is enforced by BOTH Postgres Row-Level Security (see
// the *_rls migration: FORCE RLS + a policy keyed on current_setting(
// 'app.current_tenant')) AND a request-scoped Prisma guard (server/src/db.ts)
// that sets that GUC and injects organizationId on writes.
//
// Global (no tenant, no RLS): Organization, Service, OrganizationService,
// LeadFormLink, User and Membership — identity plus the opaque public-token
// lookup that must resolve a tenant before RLS can be entered.
//
// Uniqueness is per-tenant: composite @@unique([organizationId, …]) so Acme's
// SO-1 and Beta's SO-1 coexist. IDs are cuid for API rows; the seed supplies
// explicit ids for the demo tenant so its value chain keeps referential integrity.

generator client {
  provider      = "prisma-client-js"
  // Cloud Run (Debian bookworm) + local macOS/linux.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime: the app connects as a NON-SUPERUSER role (app_user) so RLS is
  // enforced — superusers and BYPASSRLS roles ignore row-level security.
  url       = env("DATABASE_URL")
  // Migrations / seed / studio use a privileged owner role (superuser) that can
  // create tables and is not blocked by RLS. See server/prisma/setup-roles.sql.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================ tenancy plane (global)

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  status             String   @default("active") // active | trialing | suspended
  plan               String   @default("starter")
  subscriptionStatus String   @default("trialing")
  settings           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships                  Membership[]
  roles                        Role[]
  employeeGrants               EmployeeGrant[]
  customers                    Customer[]
  inquiries                    Inquiry[]
  salesOrders                  SalesOrder[]
  productionPlans              ProductionPlan[]
  logbookTemplates             LogbookTemplate[]
  machineLogbooks              MachineLogbook[]
  qualityInspections           QualityInspection[]
  inventoryTransactions        InventoryTransaction[]
  dispatchRecords              DispatchRecord[]
  complaints                   Complaint[]
  capaRecords                  CAPARecord[]
  formulations                 Formulation[]
  maintenanceTasks             MaintenanceTask[]
  machines                     Machine[]
  auditEvents                  AuditEvent[]
  services                     OrganizationService[]
  leadForms                    LeadForm[]
  mesaLeads                    MesaLead[]
  leadSubmissions              LeadSubmission[]
  leadActivities               LeadActivity[]
  leadAttachments              LeadAttachment[]
  leadFormLinks                LeadFormLink[]
  leadFormQuestions            LeadFormQuestion[]
  leadPortalLinks              LeadPortalLink[]
  leadDecisionChallenges       LeadDecisionChallenge[]
  leadQuotes                   LeadQuote[]
  leadQuoteLineItems           LeadQuoteLineItem[]
  leadQuoteEvents              LeadQuoteEvent[]
  leadFulfillments             LeadFulfillment[]
  leadMilestones               LeadMilestone[]
  legalEntities                LegalEntity[]
  financialYears               FinancialYear[]
  accountingPeriods            AccountingPeriod[]
  rolePermissions              RolePermission[]
  roleAssignments              RoleAssignment[]
  approvalPolicies             ApprovalPolicy[]
  delegations                  Delegation[]
  erpAccounts                  ErpAccount[]
  erpNumberSeries              ErpNumberSeries[]
  erpIdempotencyRecords        ErpIdempotencyRecord[]
  erpVendors                   ErpVendor[]
  erpVendorBankAccounts        ErpVendorBankAccount[]
  erpVendorDocuments           ErpVendorDocument[]
  supplierPortalUsers          SupplierPortalUser[]
  supplierPortalInvites        SupplierPortalInvite[]
  supplierPortalSessions       SupplierPortalSession[]
  erpRfqs                      ErpRfq[]
  erpRfqLines                  ErpRfqLine[]
  erpRfqInvitations            ErpRfqInvitation[]
  erpSupplierQuotations        ErpSupplierQuotation[]
  erpSupplierQuotationLines    ErpSupplierQuotationLine[]
  erpRateAgreements            ErpRateAgreement[]
  erpPoAcknowledgements        ErpPoAcknowledgement[]
  erpAdvanceShipmentNotices    ErpAdvanceShipmentNotice[]
  erpVendorChangeCases         ErpVendorChangeCase[]
  erpVendorDisputes            ErpVendorDispute[]
  erpVendorPaymentProposals    ErpVendorPaymentProposal[]
  erpSupplierInvoiceEvidence   ErpSupplierInvoiceEvidence[]
  erpCustomers                 ErpCustomer[]
  erpItems                     ErpItem[]
  erpWarehouses                ErpWarehouse[]
  erpDocuments                 ErpDocument[]
  erpDocumentLines             ErpDocumentLine[]
  erpDocumentLinks             ErpDocumentLink[]
  erpMatchCases                ErpMatchCase[]
  erpVouchers                  ErpVoucher[]
  erpVoucherLines              ErpVoucherLine[]
  erpStockMovements            ErpStockMovement[]
  erpValuationLayers           ErpValuationLayer[]
  erpValuationConsumptions     ErpValuationConsumption[]
  erpInventoryCounts           ErpInventoryCount[]
  erpPostingLinks              ErpPostingLink[]
  erpPlanningBoms              ErpPlanningBom[]
  erpPlanningBomRevisions      ErpPlanningBomRevision[]
  erpPlanningBomComponents     ErpPlanningBomComponent[]
  erpDemandForecasts           ErpDemandForecast[]
  erpStockReservations         ErpStockReservation[]
  erpMrpRuns                   ErpMrpRun[]
  erpMrpRequirements           ErpMrpRequirement[]
  erpMrpSuggestions            ErpMrpSuggestion[]
  erpTransferProposals         ErpTransferProposal[]
  erpProductionDemands         ErpProductionDemand[]
  erpManufacturingVouchers     ErpManufacturingVoucher[]
  erpBatchCosts                ErpBatchCost[]
  erpTaxDocuments              ErpTaxDocument[]
  erpComplianceRuleProfiles    ErpComplianceRuleProfile[]
  erpBankReconciliations       ErpBankReconciliation[]
  erpAssets                    ErpAsset[]
  erpBudgets                   ErpBudget[]
  erpHandoffMappings           ErpHandoffMapping[]
  erpHandoffEventRoutes        ErpHandoffEventRoute[]
  erpHandoffInboxEvents        ErpHandoffInboxEvent[]
  erpPlantQaEvidence           ErpPlantQaEvidence[]
  erpPlantDispatchEvidence     ErpPlantDispatchEvidence[]
  erpTdsSections               ErpTdsSection[]
  erpTdsRates                  ErpTdsRate[]
  erpVendorTdsClassifications  ErpVendorTdsClassification[]
  erpTdsDeductions             ErpTdsDeduction[]
  sourceLinks                  SourceLink[]
  outboxEvents                 IntegrationOutboxEvent[]
  inboxReceipts                IntegrationInboxReceipt[]
  operationalOrders            OperationalOrder[]
  mesaOpsStatutoryRuleProfiles MesaOpsStatutoryRuleProfile[]
  mesaOpsIdempotencyRecords    MesaOpsIdempotencyRecord[]
}

// MesaOrigins' global product catalog. Organizations subscribe through the
// explicit join below so one tenant can use any number of services.
model Service {
  id          String   @id
  name        String
  description String   @default("")
  status      String   @default("active") // active | paused | stopped
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations OrganizationService[]
  permissions   Permission[]
}

model OrganizationService {
  organizationId String
  serviceId      String
  status         String   @default("active") // active | suspended
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([organizationId, serviceId])
  @@index([serviceId])
}

// Global, namespaced permission catalogue. Service actions are intentionally
// explicit; MesaERP never inherits the legacy "unknown action = allow" rule.
model Permission {
  id          String @id
  serviceId   String
  key         String
  label       String
  description String @default("")
  riskLevel   String @default("standard") // standard | sensitive | high

  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([serviceId, key])
  @@index([serviceId])
}

// Opaque public form tokens live in the global plane so a request can resolve
// its tenant before the tenant RLS setting exists. Only a SHA-256 digest is
// stored; the raw bearer token is returned once when a link is created.
model LeadFormLink {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  organizationId String
  formId         String
  leadId         String?
  kind           String    @default("generic") // generic | invitation
  status         String    @default("active") // active | submitted | revoked
  expiresAt      DateTime?
  openedAt       DateTime?
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         LeadForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  lead         MesaLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submissions  LeadSubmission[]

  @@index([organizationId])
  @@index([formId])
  @@index([leadId])
}

// A generic questionnaire is shared by many customers, so each resulting lead
// receives its own opaque journey token. The digest lives in the global plane
// only to resolve the tenant; all customer-visible data stays behind tenant RLS.
model LeadPortalLink {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  organizationId String
  leadId         String    @unique
  status         String    @default("active") // active | revoked
  expiresAt      DateTime?
  lastOpenedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         MesaLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model LeadDecisionChallenge {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  emailHash      String
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         MesaLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId, expiresAt])
}

// Global identity. The same person can be a member of multiple organizations,
// so identity is separate from employment. Auth.js Account/Session attach here.
model User {
  id            String    @id @default(cuid())
  firebaseUid   String?   @unique // legacy; unused after Auth.js cutover
  email         String    @unique
  name          String
  emailVerified DateTime?
  image         String?
  passwordHash  String? // bcrypt; null = password login disabled for this user
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
}

// Auth.js OAuth account link (Google, etc.).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js database session (cookie sessionToken → this row).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// A user's employment + role within one organization (the "employee" record).
// No RLS: resolved during auth to discover which tenant a request belongs to.
model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  employeeCode   String
  department     String
  role           String
  shift          String   @default("D")
  line           String   @default("—")
  status         String   @default("active") // active | on_leave | inactive
  joinDate       String   @default("")
  location       String   @default("")
  lastSeen       String   @default("")
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  roleId String?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef             Role?                @relation(fields: [roleId], references: [id])
  grants              EmployeeGrant[]
  roleAssignments     RoleAssignment[]
  delegationsFrom     Delegation[]         @relation("DelegationFrom")
  delegationsTo       Delegation[]         @relation("DelegationTo")
  supplierPortalUsers SupplierPortalUser[]

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
}

// A tenant-defined role. Legacy MesaOps screens may use isAdmin, but MesaERP
// finance never inherits that bypass: it uses explicit RolePermission rows and
// company-scoped RoleAssignments. isSystem marks protected platform built-ins.
model Role {
  id               String   @id @default(cuid())
  organizationId   String
  erpLegalEntityId String?
  name             String
  screens          Json     @default("[]") // string[] of screen ids
  isAdmin          Boolean  @default(false)
  isSystem         Boolean  @default(false)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  erpLegalEntity LegalEntity?     @relation(fields: [erpLegalEntityId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  permissions    RolePermission[]
  assignments    RoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([erpLegalEntityId])
}

// A per-employee screen override on top of their role (state on|off). Lets an
// admin grant/revoke a single screen for one person without changing the role.
model EmployeeGrant {
  id             String   @id @default(cuid())
  organizationId String
  membershipId   String
  screen         String
  state          String   @default("on") // on | off
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId, screen])
  @@index([organizationId])
  @@index([membershipId])
}

// ============================================================ sales / CRM (tenant)

model Customer {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  gstNumber       String   @default("")
  contactPerson   String   @default("")
  phone           String   @default("")
  email           String   @default("")
  billingAddress  String   @default("")
  deliveryAddress String   @default("")
  paymentTerms    String   @default("")
  status          String   @default("active")
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiries         Inquiry[]
  salesOrders       SalesOrder[]
  complaints        Complaint[]
  operationalOrders OperationalOrder[]

  @@index([organizationId])
}

model Inquiry {
  id                   String   @id @default(cuid())
  organizationId       String
  inquiryNumber        String
  customerId           String
  product              String
  drawingRef           String   @default("")
  quantity             Int      @default(0)
  expectedDeliveryDate String   @default("")
  remarks              String   @default("")
  status               String   @default("submitted")
  attachment           String?
  quotationPrice       Float?
  negotiationNote      String?
  discountPercent      Float?
  originalPrice        Float?
  version              Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder?

  @@unique([organizationId, inquiryNumber])
  @@index([organizationId])
  @@index([customerId])
}

model SalesOrder {
  id                  String   @id @default(cuid())
  organizationId      String
  soNumber            String
  inquiryId           String   @unique
  customerId          String
  product             String
  quantity            Int      @default(0)
  deliveryDate        String   @default("")
  priority            String   @default("medium")
  specialInstructions String   @default("")
  status              String   @default("pending")
  version             Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiry          Inquiry           @relation(fields: [inquiryId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  productionPlans  ProductionPlan[]
  dispatches       DispatchRecord[]
  operationalOrder OperationalOrder?

  @@unique([organizationId, soNumber])
  @@index([organizationId])
  @@index([customerId])
}

// ============================================================ MesaLeads (tenant)

// Published forms are immutable. Editors create/update drafts and publish only
// when ready; every submission also retains a full question snapshot.
model LeadForm {
  id             String    @id @default(cuid())
  organizationId String
  familyKey      String    @default(cuid())
  name           String
  description    String    @default("")
  privacyNotice  String    @default("Your information will be used by this organization to review and respond to your enquiry.")
  status         String    @default("draft") // draft | published | archived
  revision       Int       @default(1)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions    LeadFormQuestion[]
  submissions  LeadSubmission[]
  links        LeadFormLink[]

  @@unique([organizationId, familyKey, revision])
  @@index([organizationId])
  @@index([organizationId, status])
}

model LeadFormQuestion {
  id             String   @id @default(cuid())
  organizationId String
  formId         String
  key            String
  type           String // section | short_text | long_text | email | phone | number | date | single_select | multi_select | yes_no | file
  label          String
  helpText       String   @default("")
  placeholder    String   @default("")
  required       Boolean  @default(false)
  options        Json     @default("[]")
  validation     Json     @default("{}")
  visibilityRule Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         LeadForm     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@index([organizationId])
  @@index([formId, sortOrder])
}

model MesaLead {
  id                    String    @id @default(cuid())
  organizationId        String
  reference             String
  source                String    @default("direct")
  priority              String    @default("medium") // low | medium | high
  stage                 String    @default("new")
  contactName           String    @default("")
  phone                 String    @default("")
  email                 String    @default("")
  companyName           String    @default("")
  companyAddress        String    @default("")
  gstNumber             String    @default("")
  product               String    @default("")
  requirement           String    @default("")
  scope                 String    @default("machine_only") // machine_only | machine_mold | mold_only
  ownerMembershipId     String?
  machineRecommendation String    @default("")
  clampTonnage          Float?
  shotCapacity          Float?
  moldStatus            String    @default("")
  moldSupplier          String    @default("")
  moldQuoteAmount       Float?
  quotationAmount       Float?
  quotationStatus       String    @default("not_started")
  nextFollowUpAt        DateTime?
  followUpNote          String    @default("")
  lostReason            String    @default("")
  orderReference        String    @default("")
  consentedAt           DateTime?
  version               Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions        LeadSubmission[]
  activities         LeadActivity[]
  attachments        LeadAttachment[]
  formLinks          LeadFormLink[]
  portalLink         LeadPortalLink?
  quotes             LeadQuote[]
  quoteEvents        LeadQuoteEvent[]
  fulfillment        LeadFulfillment?
  milestones         LeadMilestone[]
  decisionChallenges LeadDecisionChallenge[]

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, nextFollowUpAt])
}

// Quote content is editable only while draft. Once sent, database triggers in
// the migration freeze all commercial fields and line items; lifecycle changes
// are represented by status, decision fields and immutable LeadQuoteEvent rows.
model LeadQuote {
  id                   String    @id @default(cuid())
  organizationId       String
  leadId               String
  sourceQuoteId        String?
  versionNumber        Int
  status               String    @default("draft") // draft | sent | revision_requested | approved | superseded | withdrawn | expired
  title                String
  currency             String    @default("INR")
  validUntil           DateTime?
  summary              String    @default("")
  organizationRemarks  String    @default("")
  customerRemark       String    @default("")
  acceptanceText       String    @default("")
  acceptedByName       String    @default("")
  acceptedByEmail      String    @default("")
  terms                Json      @default("[]")
  subtotal             Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal        Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal             Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal           Decimal   @default(0) @db.Decimal(18, 2)
  createIdempotencyKey String?
  requestHash          String    @default("")
  rowVersion           Int       @default(0)
  sentAt               DateTime?
  decidedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         MesaLead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sourceQuote  LeadQuote?          @relation("QuoteRevision", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  revisions    LeadQuote[]         @relation("QuoteRevision")
  lineItems    LeadQuoteLineItem[]
  events       LeadQuoteEvent[]

  @@unique([organizationId, leadId, versionNumber])
  @@unique([organizationId, createIdempotencyKey])
  @@index([organizationId])
  @@index([leadId, versionNumber])
  @@index([leadId, status])
}

model LeadQuoteLineItem {
  id             String   @id @default(cuid())
  organizationId String
  quoteId        String
  sortOrder      Int      @default(0)
  description    String
  specification  String   @default("")
  hsnSacCode     String   @default("")
  quantity       Decimal  @db.Decimal(18, 4)
  unit           String   @default("nos")
  unitPrice      Decimal  @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  taxRate        Decimal  @default(0) @db.Decimal(7, 4)
  taxableAmount  Decimal  @db.Decimal(18, 2)
  taxAmount      Decimal  @db.Decimal(18, 2)
  total          Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        LeadQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([quoteId, sortOrder])
}

model LeadQuoteEvent {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  quoteId        String
  type           String // created | updated | sent | revision_requested | approved | superseded | revised
  actorType      String // organization | customer | system
  actorUserId    String?
  actorEmail     String   @default("")
  remark         String   @default("")
  metadata       Json     @default("{}")
  idempotencyKey String?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         MesaLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quote        LeadQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([leadId, occurredAt])
  @@index([quoteId, occurredAt])
}

model LeadFulfillment {
  id                      String    @id @default(cuid())
  organizationId          String
  leadId                  String    @unique
  status                  String    @default("not_started") // not_started | in_progress | on_hold | completed | cancelled
  customerSummary         String    @default("")
  estimatedCompletionDate DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createIdempotencyKey    String?
  requestHash             String    @default("")
  rowVersion              Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         MesaLead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  milestones   LeadMilestone[]

  @@unique([organizationId, createIdempotencyKey])
  @@index([organizationId])
  @@index([organizationId, status])
}

model LeadMilestone {
  id                   String    @id @default(cuid())
  organizationId       String
  leadId               String
  fulfillmentId        String
  name                 String
  sortOrder            Int       @default(0)
  status               String    @default("pending") // pending | in_progress | blocked | completed | cancelled
  targetDate           DateTime?
  completedAt          DateTime?
