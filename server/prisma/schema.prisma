// Approved MesaOps dispatch applicability is tenant-owned and independent of
// MesaERP. Each approved version is immutable and scoped by country, plant,
// movement and effective dates. A reviewed exemption is represented by an
// approved profile with both artifact requirements false and a nonblank reason.
model MesaOpsStatutoryRuleProfile {
  id                      String    @id @default(cuid())
  organizationId          String
  version                 String
  countryCode             String    @default("IN")
  plantCode               String    @default("*")
  movementType            String    @default("*")
  effectiveFrom           DateTime  @db.Date
  effectiveTo             DateTime? @db.Date
  status                  String    @default("draft") // draft | approved
  requiresInvoice         Boolean
  requiresEWayBill        Boolean
  reviewedExemptionReason String    @default("")
  sourceReference         String
  sourceEvidence          Json
  sourceChecksum          String
  createIdempotencyKey    String?
  requestHash             String    @default("")
  rowVersion              Int       @default(0)
  createdBy               String
  approvedBy              String    @default("")
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, version], map: "MesaOpsStatutoryRuleProfile_identity_key")
  @@unique([organizationId, createIdempotencyKey], map: "MesaOpsStatutoryRuleProfile_idempotency_key")
  @@index([organizationId, status, countryCode, plantCode, movementType, effectiveFrom], map: "MesaOpsStatutoryRuleProfile_lookup_idx")
}

