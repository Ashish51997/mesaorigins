// ============================================================ MesaERP masters + commercial documents

model ErpAccount {
  id                     String   @id @default(cuid())
  organizationId         String
  legalEntityId          String
  code                   String
  name                   String
  accountType            String // asset | liability | equity | income | expense
  classification         String   @default("other")
  cashFlowClass          String   @default("operating") // operating | investing | financing | cash | non_cash
  parentId               String?
  currency               String   @default("INR")
  allowPosting           Boolean  @default(true)
  reconciliationRequired Boolean  @default(false)
  active                 Boolean  @default(true)
  rowVersion             Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity  LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  parent       ErpAccount?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     ErpAccount[]     @relation("AccountTree")
  voucherLines ErpVoucherLine[]

  @@unique([organizationId, legalEntityId, code])
  @@index([organizationId])
  @@index([legalEntityId, accountType])
}

model ErpVendor {
  id                 String   @id @default(cuid())
