// ============================================================ standards / registry (tenant)

// A production formulation (BOM/recipe) revision: a coded set of RM components
// with their %. Each code carries revisions; the latest active one is used on
// the line. A revision can be locked (e.g. by a CAPA) so it can't be edited.
model Formulation {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  rev            Int      @default(1)
  product        String   @default("")
  active         Boolean  @default(true)
  locked         Boolean  @default(false)
  lockReason     String   @default("")
  capaId         String?
  components     Json     @default("[]") // [{ name, pct, lotId }]
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code, rev])
  @@index([organizationId])
}

model MaintenanceTask {
