  @@index([legalEntityId, assetId, businessDate])
}

/// Correlation record for two independent company vouchers. Each company keeps
/// its own lifecycle; this record never silently advances either voucher.
model ErpIntercompanyPair {
  id                   String    @id @default(cuid())
  organizationId       String
  sourceLegalEntityId  String
  targetLegalEntityId  String
  sourceVoucherId      String
  targetVoucherId      String
  reference            String
  businessDate         DateTime  @db.Date
  sourceCurrency       String
  targetCurrency       String
  sourceAmount         Decimal   @db.Decimal(18, 2)
  targetAmount         Decimal   @db.Decimal(18, 2)
  exchangeRate         Decimal   @db.Decimal(18, 8)
  rateEffectiveFrom    DateTime  @db.Date
  rateEffectiveTo      DateTime? @db.Date
  rateSourceReference  String
  sourceSnapshot       Json
  sourceSnapshotHash   String
  status               String    @default("draft")
  createIdempotencyKey String?
  requestHash          String    @default("")
  createdBy            String
  rowVersion           Int       @default(0)
  createdAt            DateTime  @default(now())
