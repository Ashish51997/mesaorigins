// MesaOps owns this demand record. It can stand alone or retain an immutable
// link to a MesaERP sales-order snapshot; machine assignment remains on plans.
model OperationalOrder {
  id                   String    @id @default(cuid())
  organizationId       String
  plantCode            String    @default("PRIMARY")
  orderNumber          String
  sourceType           String    @default("local_customer") // local_customer | internal | forecast | replenishment | trial | rework | import | mesaerp
  sourceReference      String    @default("")
  sourceLinkId         String?
  legacySalesOrderId   String?   @unique
  customerId           String?
  customerName         String    @default("")
  productCode          String    @default("")
  productName          String
  quantity             Decimal   @db.Decimal(18, 6)
  uom                  String    @default("units")
  dueDate              DateTime? @db.Date
  priority             String    @default("medium")
  requirements         Json      @default("{}")
  originMetadata       Json      @default("{}")
  sourceSnapshotHash   String    @default("")
  status               String    @default("ready_to_plan")
  createIdempotencyKey String?
  rowVersion           Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceLink       SourceLink?      @relation(fields: [sourceLinkId], references: [id], onDelete: Restrict)
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  legacySalesOrder SalesOrder?      @relation(fields: [legacySalesOrderId], references: [id], onDelete: Restrict)
  productionPlans  ProductionPlan[]
  dispatches       DispatchRecord[]

  @@unique([organizationId, orderNumber])
  @@unique([organizationId, createIdempotencyKey])
  @@index([organizationId])
  @@index([organizationId, plantCode, status])
  @@index([organizationId, sourceType, status])
  @@index([sourceLinkId])
}

// Durable response ledger for retry-safe MesaOps lifecycle writes. A scope and
// key identify one logical request; the request hash prevents key reuse with a
// different payload.
model MesaOpsIdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  scope          String
  key            String
  requestHash    String
  response       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, key])
  @@index([organizationId, createdAt])
}
