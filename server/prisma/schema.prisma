  @@unique([organizationId, createIdempotencyKey])
  @@unique([organizationId, sourceVoucherId])
  @@unique([organizationId, targetVoucherId])
  @@index([organizationId])
  @@index([sourceLegalEntityId, targetLegalEntityId, businessDate])
}

